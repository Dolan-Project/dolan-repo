{
  "name": "@dolan/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:photos": "node ./scripts/seed-places-photos.mjs",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "verify": "node ./scripts/verify-migrations.mjs",
    "backup": "node ./scripts/backup.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.13",
    "embedded-postgres": "^18.4.0-beta.17",
    "sequelize-cli": "^6.6.3",
    "typescript": "^5.9.2"
  }
}
