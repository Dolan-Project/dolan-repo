NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Live demo / local auth: set false so login uses Express + Postgres (not typed mock "Salsa").
NEXT_PUBLIC_USE_MOCK_API=false
EXPRESS_ORIGIN=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
# Production cookies also set Secure when NODE_ENV=production.
SOCKET_PATH=/socket.io
LOG_LEVEL=info

# Database
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dolan
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_LOGGING=false

# Auth — local password + Google OAuth in Express (default). Use AUTH_ADAPTER=mock only for API unit tests.
AUTH_ADAPTER=local
SESSION_TTL_DAYS=30
# Google Sign-In (Express OAuth). Redirect URI must match Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# User media
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Maps, Places, Routes, and AI
# Also used once during `npm run db:seed` / `db:seed:photos` to download destination photos
# into dolan/public/seed-places + places.cached_photo_url (runtime then skips Places Photo).
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PLACES_MAX_REQUESTS_PER_USER_PER_DAY=50
PLACES_ESTIMATED_COST_PER_REQUEST=0.01
AI_MAX_REGENERATE_PER_USER_PER_DAY=

# Worker
WORKER_ID=worker-1
JOB_POLL_INTERVAL_MS=2000
JOB_LOCK_TIMEOUT_MS=300000
JOB_RETRY_BACKOFF_MS=2000

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SEARCH_MAX=40

# Location and limited share links
LOCATION_STALE_SECONDS=120
LOCATION_HIDE_SECONDS=600
SHARE_TOKEN_SECRET=
SHARE_LINK_TTL_HOURS=168

# Push and email
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=  # browser PushOptIn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_PROVIDER_API_KEY=
# For local tests without a verified domain, use: Dolan <onboarding@resend.dev>
# (Resend only delivers to your Resend account email until a domain is verified.)
EMAIL_FROM=
