# Database (WIRA-D1)
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dolan
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_LOGGING=false

# Server
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
SOCKET_PATH=/socket.io
AUTH_ADAPTER=mock
LOG_LEVEL=info

# Next.js / Salsa (public names only)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Auth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COOKIE_PREFIX=sb-
SUPABASE_STORAGE_BUCKET=dolan-assets

# Maps / AI / Places
GOOGLE_MAPS_SERVER_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PLACES_MAX_REQUESTS_PER_USER_PER_DAY=50
AI_MAX_REGENERATE_PER_USER_PER_DAY=

# Worker / jobs
WORKER_ID=worker-1
JOB_POLL_INTERVAL_MS=2000
JOB_LOCK_TIMEOUT_MS=300000
JOB_RETRY_BACKOFF_MS=2000

# Location + share (ALYA-D4)
LOCATION_STALE_SECONDS=120
LOCATION_HIDE_SECONDS=600
SHARE_TOKEN_SECRET=
SHARE_LINK_TTL_HOURS=168

# Push / email (belum wajib D4)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
