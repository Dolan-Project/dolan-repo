NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK_API=true
EXPRESS_ORIGIN=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
SOCKET_PATH=/socket.io
LOG_LEVEL=info

# Database
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dolan
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_LOGGING=false

# Auth
AUTH_ADAPTER=mock
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COOKIE_PREFIX=sb-
SUPABASE_STORAGE_BUCKET=dolan-assets

# User media
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Maps, Places, Routes, and AI
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PLACES_MAX_REQUESTS_PER_USER_PER_DAY=50
PLACES_ESTIMATED_COST_PER_REQUEST=0.01
AI_MAX_REGENERATE_PER_USER_PER_DAY=

# Worker
WORKER_ID=worker-1
JOB_POLL_INTERVAL_MS=2000
JOB_LOCK_TIMEOUT_MS=300000
JOB_RETRY_BACKOFF_MS=2000

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SEARCH_MAX=40

# Location and limited share links
LOCATION_STALE_SECONDS=120
LOCATION_HIDE_SECONDS=600
SHARE_TOKEN_SECRET=
SHARE_LINK_TTL_HOURS=168

# Push and email
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
